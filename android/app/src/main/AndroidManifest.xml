<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 마스터 서버와 UDP/HTTP 통신을 위한 네트워크 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- UDP 멀티캐스트 수신(MulticastLock)을 위해 필요 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 설치 환경에서 화면 꺼짐 방지를 위해 필요 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Scoped Storage 우회: /sdcard 영상 파일 접근을 위해 필요 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- OTA 무인 설치(PackageInstaller)용. Device Owner 상태에서는 이 권한 선언 없이도
         설치가 되는 것으로 보이나, 문서상 애매해 우선 선언해둠 - 실기기 테스트 후 불필요하면 제거 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaSphere">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MediaSphere"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OTA로 앱이 갱신된 직후 시스템이 보내는 브로드캐스트 - MainActivity를 재실행한다 -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- adb shell dpm set-device-owner com.mediasphere.client/.DeviceAdminReceiver 로
             이 앱을 Device Owner로 등록하기 위한 필수 구성요소. exported=true + BIND_DEVICE_ADMIN
             권한은 시스템만 이 리시버를 호출할 수 있게 하는 표준 조합(공식 문서 권장 방식). -->
        <receiver
            android:name=".DeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>